# Copy the below to `.env` and fill in.

# Groq is used via LiteLLM's "groq/" provider prefix. Get a free key:
#   https://console.groq.com/keys
GROQ_API_KEY=your-groq-key-here

# --- News source (optional; Channel B still serves stock quotes without it) ---
# https://newsapi.org/register
NEWSAPI_KEY=your-newsapi-key-here

# --- Hosted embeddings / LLM (only needed if you switch backends below) ---
OPENAI_API_KEY=
GEMINI_API_KEY=

# --- Pathway license (Community tier works with the demo telemetry key) ---
PATHWAY_LICENSE_KEY=demo-license-key-with-telemetry

# ---------------------------------------------------------------------------
# Optional overrides (defaults shown; uncomment to change)
# ---------------------------------------------------------------------------
# EMBEDDER_BACKEND=local          # local | openai | gemini
# EMBEDDER_MODEL=BAAI/bge-small-en-v1.5
# LLM_BACKEND=groq                # groq | openai
# LLM_MODEL=groq/llama-3.3-70b-versatile
# RAG_MODE=base                   # base | adaptive
# INDEX_BACKEND=bruteforce        # bruteforce | usearch
# PARSER_BACKEND=utf8             # utf8 (lean) | docling (rich PDF)
# SEARCH_TOPK=6
# CHUNK_MAX_TOKENS=400
# DOCS_DIR=./data/docs
# QUOTE_POLL_SECONDS=20
# NEWS_POLL_SECONDS=300
# HOST=0.0.0.0
# PORT=8000
# REQUEST_TIMEOUT_S=10
# LLM_CAPACITY=8
