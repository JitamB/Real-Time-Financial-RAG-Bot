# Copy the below to `.env` and fill in.

# Groq is used via LiteLLM's "groq/" provider prefix. Get a free key:
#   https://console.groq.com/keys
GROQ_API_KEY=your-groq-key-here

# --- News source (optional; Channel B still serves stock quotes without it) ---
# https://newsapi.org/register
NEWSAPI_KEY=your-newsapi-key-here

# --- Hosted embeddings / LLM (only needed if you switch backends below) ---
OPENAI_API_KEY=
GEMINI_API_KEY=

# --- Pathway license (Community tier works with the demo telemetry key) ---
PATHWAY_LICENSE_KEY=demo-license-key-with-telemetry

# ---------------------------------------------------------------------------
# Optional overrides (defaults shown; uncomment to change)
# ---------------------------------------------------------------------------
# EMBEDDER_BACKEND=local          # local | openai | gemini
# EMBEDDER_MODEL=BAAI/bge-small-en-v1.5
# LLM_BACKEND=groq                # groq | openai
# LLM_MODEL=groq/llama-3.3-70b-versatile
# RAG_MODE=base                   # base | adaptive
# INDEX_BACKEND=bruteforce        # bruteforce | usearch (HNSW; >~50k chunks)
# PARSER_BACKEND=utf8             # utf8 (lean) | docling (rich PDF)

# --- Retrieval quality (sentence-aware overlap + two-stage rerank) ---
# SPLITTER_BACKEND=recursive      # recursive (overlap) | token (hard cuts)
# CHUNK_MAX_TOKENS=400
# CHUNK_OVERLAP=80                # token overlap between chunks (recursive only)
# RERANKER_BACKEND=flashrank      # flashrank (fast) | cross_encoder | none
# RETRIEVE_TOPK=20                # wide vector pool before rerank
# SEARCH_TOPK=6                   # final chunks to the LLM (post-rerank)
# FLASHRANK_MODEL=ms-marco-TinyBERT-L-2-v2
# CROSS_ENCODER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# --- Live feed dedup + chat UX ---
# NEWS_DEDUP=true                 # skip re-embedding unchanged quote/news rows
# CHAT_HISTORY_TURNS=3            # prior turns prepended for follow-ups (0=off)

# --- Paths / cadence / serving ---
# DOCS_DIR=./data/docs
# QUOTE_POLL_SECONDS=20
# NEWS_POLL_SECONDS=300
# HOST=0.0.0.0
# PORT=8000
# REQUEST_TIMEOUT_S=10
# LLM_CAPACITY=8
